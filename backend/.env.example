# Gemini API key used by the assistant's gemini-2.5-flash function-calling requests.
GEMINI_API_KEY=
# ElevenLabs API key used to stream synthesized narration audio.
ELEVENLABS_API_KEY=
# Optional ElevenLabs overrides.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# NASA NeoWs API key; DEMO_KEY is a rate-limited option for local development.
NASA_API_KEY=DEMO_KEY
# Address the ASGI server binds to; 0.0.0.0 makes it reachable from the frontend/dev network.
HOST=0.0.0.0
# Port used by the local FastAPI/Uvicorn server.
PORT=8000
